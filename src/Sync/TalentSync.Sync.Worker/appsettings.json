{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "EventHubs": {
    "HubName": "ats-events",
    "ConsumerGroup": "sync-worker"
  },
  "Checkpoints": {
    "Container": "sync-worker-checkpoints"
  },
  "Consumer": {
    "InitialBackoff": "00:00:01",
    "MaxBackoff": "00:00:30",
    "MaxUnclassifiedAttempts": 5
  },
  "Teamtailor": {
    "ApiVersion": "20240904",
    "QualifiedStageName": "Qualified",
    "Resilience": {
      "Retry": {
        "MaxRetryAttempts": 2
      }
    }
  },
  "Crm": {
    "Resilience": {
      "Retry": {
        "MaxRetryAttempts": 2
      }
    }
  }
}
