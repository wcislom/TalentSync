{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "EventHubs": {
    "HubName": "ats-events",
    "ConsumerGroup": "matching-worker"
  },
  "Checkpoints": {
    "Container": "matching-worker-checkpoints"
  },
  "Consumer": {
    "InitialBackoff": "00:00:01",
    "MaxBackoff": "00:00:30",
    "MaxUnclassifiedAttempts": 5
  },
  "Teamtailor": {
    "ApiVersion": "20240904",
    "QualifiedStageName": "Qualified",
    "Resilience": {
      "Retry": {
        "MaxRetryAttempts": 2
      }
    }
  },
  "MatchingPlatform": {
    "Resilience": {
      "Retry": {
        "MaxRetryAttempts": 2
      }
    }
  },
  "Llm": {
    "Provider": "Fake",
    "Timeout": "00:00:30",
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 4,
      "SamplingDuration": "00:01:00",
      "BreakDuration": "00:00:30"
    },
    "Fake": {
      "Mode": "Valid"
    },
    "Anthropic": {
      "Model": "claude-haiku-5-5",
      "MaxOutputTokens": 8000,
      "MaxRetries": 2
    }
  }
}
